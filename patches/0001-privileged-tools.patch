@@ -0,0 +1,81 @@
+// [dshgo-mod] Privileged shell executor for the MAIN screen.
+//
+// The existing PrivilegedDisplayCore is bound to the background virtual display
+// (every op calls requireDisplay()), so its injectTap/sendMotion cannot be reused
+// for WeChat on the main screen. This class adds a second, minimal path that runs
+// `input` / `screencap` / `dumpsys` as the shell uid over the already-paired adb
+// stream, which is the identity that can inject events into any app.
+//
+// NOTHING here touches the virtual-display engine. It is additive only.
+package io.github.ccch1mneyyy.dsh_app.phone.background
+
+import io.github.muntashirakon.adb.AdbStream
+import java.io.ByteArrayOutputStream
+import java.util.concurrent.TimeUnit
+
+/**
+ * One shell command over a dedicated adb `shell:` stream.
+ *
+ * The adb channel opens a fresh stream per command (the privileged-display stream is
+ * request/response framed and must not be shared). Commands are serialised by the
+ * caller, which is the phone bridge's single worker thread.
+ */
+class PrivilegedShell(private val opener: () -> AdbStream?) {
+
+    /** Runs [command] and returns (exitCode, stdout+stderr). Never throws. */
+    fun run(command: String, timeoutMs: Long = 15_000): Result {
+        val stream = runCatching { opener() }.getOrNull()
+            ?: return Result(-1, "", "shell stream unavailable")
+        return try {
+            val out = stream.openOutputStream()
+            val input = stream.openInputStream()
+            out.write((command + "\n").toByteArray())
+            out.flush()
+            val buf = ByteArrayOutputStream()
+            val deadline = System.nanoTime() + TimeUnit.MILLISECONDS.toNanos(timeoutMs)
+            var exit: String? = null
+            // libadb-android ends each shell response with "exit:<code>"; read until we see it.
+            val reader = input.bufferedReader()
+            while (System.nanoTime() < deadline) {
+                val line = reader.readLine() ?: break
+                if (line.startsWith("exit:")) { exit = line.removePrefix("exit:").trim(); break }
+                buf.write(line.toByteArray()); buf.write('\n'.code)
+            }
+            Result(exit?.toIntOrNull() ?: -1, buf.toString("UTF-8"), null)
+        } catch (e: Exception) {
+            Result(-1, "", e.javaClass.simpleName)
+        } finally {
+            runCatching { stream.close() }
+        }
+    }
+
+    data class Result(val exitCode: Int, val output: String, val error: String?) {
+        val ok: Boolean get() = error == null && exitCode == 0
+    }
+
+    // ---- typed helpers the tool layer uses ----
+
+    fun tap(x: Int, y: Int): Boolean = run("input tap $x $y").ok
+
+    fun swipe(x1: Int, y1: Int, x2: Int, y2: Int, ms: Int): Boolean =
+        run("input swipe $x1 $y1 $x2 $y2 $ms").ok
+
+    fun key(code: Int): Boolean = run("input keyevent $code").ok
+
+    /** ASCII only: `input text` cannot carry CJK. Callers must reject non-ASCII upstream. */
+    fun text(ascii: String): Boolean = run("input text ${quote(ascii)}").ok
+
+    /** Current foreground package/activity, from dumpsys (NOT `cmd dumpsys`, which is unrouted). */
+    fun foreground(): String? = run("dumpsys window | grep -E 'mCurrentFocus|mFocusedApp'")
+        .output.lineSequence()
+        .mapNotNull { line ->
+            Regex("""[a-z][a-z0-9_]*(\.[a-z0-9_]+)+/[A-Za-z0-9_.$]+""").find(line)?.value
+        }
+        .firstOrNull()
+
+    fun keyboardShown(): Boolean = run("dumpsys input_method | grep mInputShown").output.contains("mInputShown=true")
+
+    fun screenshot(path: String): Boolean = run("screencap -p ${quote(path)}").ok
+
+    private fun quote(s: String): String = "'" + s.replace("'", "'\\''") + "'"
+}
